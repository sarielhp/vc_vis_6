              refine extStar_escape_blocker hP hccw hA hH hesc hxm_out
                (pair_subset_of_mem hac_in hbc_in) (by omega) (by omega) hfx ?_
              dsimp only
              cases hip : intrinsicPol S w (toF7 xm) <;> rw [hip] at hsub_b <;>
                simp only [Bool.false_eq_true, if_false, if_true] at hsub_b ⊢ <;>
                exact subArcB_sound _ _ _ _ hsub_b
            · rw [Bool.eq_false_iff.mpr hop23] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
