              · rw [hop24] at h; exact Bool.noConfusion h
              · rw [hop24] at h; simp only [↓reduceIte] at h
                exact ih .root known w1 hK trivial h

theorem checkSec3Table_sound :
    ∀ (d base off : ℕ) (t : Sec3Table),
      off < (1 <<< d) →
      base + off < 768 →
      checkSec3Table d base t = true →
      (verifyFuel 32 .root (kOfIdx ((base + off) / 128)) ((base + off) % 128) []
        (sec3Get d off t)).1 = true
  | 0, base, off, t, hoff, hlt, hchk => by
    have hoff0 : off = 0 := by change off < 1 at hoff; omega
    subst hoff0; rw [Nat.add_zero] at hlt ⊢
    cases t with
    | empty =>
      simp only [checkSec3Table, Nat.ble_eq] at hchk; omega
    | leaf w =>
      simp only [checkSec3Table] at hchk
      have hnb : Nat.ble 768 base = false := Bool.eq_false_iff.mpr (fun e => by have := Nat.ble_eq.mp e; omega)
      rw [hnb] at hchk; exact hchk
    | branch _ _ => nomatch hchk
  | d + 1, base, off, t, hoff, hlt, hchk => by
    cases t with
    | empty =>
      simp only [checkSec3Table, Nat.ble_eq] at hchk; omega
    | leaf _ => nomatch hchk
    | branch l r =>
      dsimp [checkSec3Table] at hchk
      simp only [Bool.and_eq_true] at hchk
      have hpow : (1 <<< (d + 1)) = (1 <<< d) + (1 <<< d) := by
        simp [Nat.shiftLeft_eq]; omega
      dsimp [sec3Get]
      by_cases hlt_half : off < (1 <<< d)
      · rw [if_pos hlt_half]
        exact checkSec3Table_sound d base off l hlt_half hlt hchk.1
      · rw [if_neg hlt_half]
        have heq_idx : (base + (1 <<< d)) + (off - (1 <<< d)) = base + off := by omega
        have hres := checkSec3Table_sound d (base + (1 <<< d)) (off - (1 <<< d)) r
          (by omega) (by omega) hchk.2
        rwa [heq_idx] at hres

