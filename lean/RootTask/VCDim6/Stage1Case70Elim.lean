/-! ## 5. Regime Classification, Relabeling to `CCWConvexSeven`, Theorem 3.1, and `VC-dim(P) ≤ 11` -/

def packPol7 (b0 b1 b2 b3 b4 b5 b6 : Bool) : ℕ :=
  (if b0 then 1 else 0) +
  (if b1 then 2 else 0) +
  (if b2 then 4 else 0) +
  (if b3 then 8 else 0) +
  (if b4 then 16 else 0) +
  (if b5 then 32 else 0) +
  (if b6 then 64 else 0)

private lemma packPol7_props (b0 b1 b2 b3 b4 b5 b6 : Bool) (x : Fin 7) :
    packPol7 b0 b1 b2 b3 b4 b5 b6 < 128 ∧
    polBit (packPol7 b0 b1 b2 b3 b4 b5 b6) x.val = (![b0, b1, b2, b3, b4, b5, b6] x) := by
  revert b0 b1 b2 b3 b4 b5 b6 x; decide

def polMaskOf (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ) : ℕ :=
  packPol7 (intrinsicPol S w 0) (intrinsicPol S w 1) (intrinsicPol S w 2) (intrinsicPol S w 3)
           (intrinsicPol S w 4) (intrinsicPol S w 5) (intrinsicPol S w 6)

lemma polMaskOf_lt (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ) :
    polMaskOf S w < 128 :=
  (packPol7_props _ _ _ _ _ _ _ 0).1

lemma polBit_polMaskOf (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ) (x : Fin 7) :
    polBit (polMaskOf S w) x.val = intrinsicPol S w x := by
  have h := (packPol7_props (intrinsicPol S w 0) (intrinsicPol S w 1) (intrinsicPol S w 2)
    (intrinsicPol S w 3) (intrinsicPol S w 4) (intrinsicPol S w 5) (intrinsicPol S w 6) x).2
  change polBit (polMaskOf S w) x.val = _ at h
  rw [h]; fin_cases x <;> rfl

/-- Refutes any `CCWConvexSeven` instance satisfying `ValidSec3Regime P S w k` (`k ∈ {0, 2, 3, 4, 5, 6}`). -/
theorem refute_ccw_regime {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ} {w : Finset (Fin 7) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    (hA : PolygonCore.interiorPoints S = ∅) (hH : PolygonCore.certifiedSet P S w = ∅)
    {kIdx : ℕ} (hkIdx : kIdx < 6)
    (hReg : ValidSec3Regime P S w (kOfIdx kIdx)) : False := by
  let pm := polMaskOf S w
  have hpm : pm < 128 := polMaskOf_lt S w
  let idx := kIdx * 128 + pm
  have hidx_lt : idx < 768 := by omega
  have hidx_lt10 : idx < (1 <<< 10) := by change idx < 1024; omega
  have hdiv : idx / 128 = kIdx := by omega
  have hmod : idx % 128 = pm := by omega
  have hok := checkSec3Table_sound 10 0 idx sec3_table hidx_lt10 (by omega) sec3_all_ok
  rw [Nat.zero_add, hdiv, hmod] at hok
  exact verifyFuel_sound hP hccw hA hH hReg (polBit_polMaskOf S w) 32 .root []
    (sec3Get 10 idx sec3_table) (fun _ ht => nomatch ht) trivial hok

/-- Not all 7 hull edges of `CCWConvexSeven S` can simultaneously face a point `v`. -/
private lemma not_all_seven_edges_facing {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ}
    {w : Finset (Fin 7) → ℝ × ℝ} (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    (T : Finset (Fin 7))
    (hall : ∀ u : Fin 7, orientSign (S u) (S (u + 1)) (w T) = false) : False := by
  have f02 : orientSign (S 0) (S 2) (w T) = false :=
    facing_arc_chord_false hP hccw (by decide) (fun u _ => hall u)
  have f24 : orientSign (S 2) (S 4) (w T) = false :=
    facing_arc_chord_false hP hccw (by decide) (fun u _ => hall u)
  have f40 : orientSign (S 4) (S 0) (w T) = false :=
    facing_arc_chord_false hP hccw (by decide) (fun u _ => hall u)
  have l02 := (orientSign_eq_false_iff_of_ne_zero (orient_S_S_w_ne hP (by decide) T)).mp f02
  have l24 := (orientSign_eq_false_iff_of_ne_zero (orient_S_S_w_ne hP (by decide) T)).mp f24
  have l40 := (orientSign_eq_false_iff_of_ne_zero (orient_S_S_w_ne hP (by decide) T)).mp f40
  have hpos : 0 < orient2D (S 0) (S 2) (S 4) := orient2D_pos_of_ccw hccw (by decide) (by decide)
  have hsum := orient2D_tri_sum (S 0) (S 2) (S 4) (w T)
  linarith

private lemma esc_two_edges_props (ι : Fin 7) (tag : Fin 3) :
    let a := (chainEndpoints ι tag).1
    let b := (chainEndpoints ι tag).2
    a ≠ a + 1 ∧ (a - a).val < (b - a).val ∧ ((a + 1) - a).val < (b - a).val := by
  fin_cases ι <;> fin_cases tag <;> decide

private lemma univ_image_perm7 (σ : Equiv.Perm (Fin 7)) :
    (Finset.univ : Finset (Fin 7)).image σ = Finset.univ := by
  ext x; simp only [Finset.mem_image, Finset.mem_univ, true_and, iff_true]
  exact ⟨σ.symm x, σ.apply_symm_apply x⟩

/-- Refutes any `CCWConvexSeven` instance with `interiorPoints S = ∅` and `certifiedSet P S w = ∅`. -/
theorem no_ccw_unmarked_convex_seven {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ}
    {w : Finset (Fin 7) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    (hA : PolygonCore.interiorPoints S = ∅) (hH : PolygonCore.certifiedSet P S w = ∅) :
    False := by
  by_cases htwo : ∃ u₁ u₂ : Fin 7, u₁ ≠ u₂ ∧
      orientSign (S u₁) (S (u₁ + 1)) (w Finset.univ) = false ∧
      orientSign (S u₂) (S (u₂ + 1)) (w Finset.univ) = false
  · rcases htwo with ⟨u₁, u₂, hu12, hf1, hf2⟩
    obtain ⟨vc⟩ := exists_vc_of_facing_edge hP hccw hf1
    have hd_lt7 : vc.d_near < 7 := by
      by_contra hge
      exact not_all_seven_edges_facing hP hccw Finset.univ (fun u =>
        (vc_facing_iff hP vc u).mpr (lt_of_lt_of_le (u - vc.i_max).isLt (Nat.le_of_not_lt hge)))
    have hd_ge2 : 2 ≤ vc.d_near := by
      have l1 := (vc_facing_iff hP vc u₁).mp hf1
      have l2 := (vc_facing_iff hP vc u₂).mp hf2
      have hne_sub : (u₁ - vc.i_max).val ≠ (u₂ - vc.i_max).val :=
        fun hv => hu12 (sub_left_injective (Fin.ext hv))
      omega
    let σ : Equiv.Perm (Fin 7) := Equiv.addLeft vc.i_max
    let S' := relabelS σ S
    let w' := relabelW σ w
    have hP' : ShatteredSimplePolygon P S' w' := shattered_relabel hP σ
    have hccw' : CCWConvexSeven S' := by
      intro i j k h1 h2
      have heq1 : (vc.i_max + j) - (vc.i_max + i) = j - i := add_sub_add_left_eq_sub j i vc.i_max
      have heq2 : (vc.i_max + k) - (vc.i_max + i) = k - i := add_sub_add_left_eq_sub k i vc.i_max
      exact hccw (vc.i_max + i) (vc.i_max + j) (vc.i_max + k)
        (heq1.symm ▸ h1) (heq1.symm ▸ heq2.symm ▸ h2)
    have hA' : PolygonCore.interiorPoints S' = ∅ := by
      rw [Finset.eq_empty_iff_forall_notMem]
      intro i hi; rw [mem_interiorPoints_relabel, hA] at hi; exact Finset.notMem_empty _ hi
    have hH' : PolygonCore.certifiedSet P S' w' = ∅ := by
      rw [Finset.eq_empty_iff_forall_notMem]
      intro i hi; rw [mem_certifiedSet_relabel, hH] at hi; exact Finset.notMem_empty _ hi
    have hw_univ : w' Finset.univ = w Finset.univ := by
      change w (Finset.univ.image σ) = w Finset.univ
      rw [univ_image_perm7]
    have hext' : IsExteriorStar S' w' vc.d_near := by
      refine ⟨hd_ge2, by omega, fun u => ?_⟩
      change orientSign (S (vc.i_max + u)) (S (vc.i_max + (u + 1))) (w' Finset.univ) = false ↔ u.val < vc.d_near
      rw [hw_univ, ← add_assoc, vc_facing_iff hP vc (vc.i_max + u), add_sub_cancel_left]
    have hk_cases : vc.d_near = 2 ∨ vc.d_near = 3 ∨ vc.d_near = 4 ∨ vc.d_near = 5 ∨ vc.d_near = 6 := by omega
    rcases hk_cases with hk | hk | hk | hk | hk
    · rw [hk] at hext'
      exact refute_ccw_regime hP' hccw' hA' hH' (kIdx := 1) (by decide) hext'
    · rw [hk] at hext'
      exact refute_ccw_regime hP' hccw' hA' hH' (kIdx := 2) (by decide) hext'
    · rw [hk] at hext'
      exact refute_ccw_regime hP' hccw' hA' hH' (kIdx := 3) (by decide) hext'
    · rw [hk] at hext'
      exact refute_ccw_regime hP' hccw' hA' hH' (kIdx := 4) (by decide) hext'
    · rw [hk] at hext'
      exact refute_ccw_regime hP' hccw' hA' hH' (kIdx := 5) (by decide) hext'
  · push Not at htwo
    have hNoEsc : NoEscapeRegime P S w := by
      intro ι tag s hesc
      have ep := esc_two_edges_props ι tag
      let a := (chainEndpoints ι tag).1
      exact htwo a (a + 1) ep.1 (hesc.2.2 a ep.2.1).2 (hesc.2.2 (a + 1) ep.2.2).2
    exact refute_ccw_regime hP hccw hA hH (kIdx := 0) (by decide) hNoEsc

private lemma cyclicOrder7_of_sub_lt (i j k : Fin 7) :
    0 < (j - i).val → (j - i).val < (k - i).val →
    PolygonCore.CyclicOrder (N := 7) i j k := by
  unfold PolygonCore.CyclicOrder
  fin_cases i <;> fin_cases j <;> fin_cases k <;> decide

/-- **Theorem 3.1 (`no_unmarked_convex_seven_shattered`, 100% Certificate-Free)**:
    No simple polygon `P` can shatter `7` points in strictly convex position (`interiorPoints S = ∅`)
    with empty certified set (`certifiedSet P S w = ∅`). -/
theorem no_unmarked_convex_seven_shattered {P : Set (ℝ × ℝ)}
    (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ)
    (hP : ShatteredSimplePolygon P S w)
    (hA : PolygonCore.interiorPoints S = ∅)
    (hH : PolygonCore.certifiedSet P S w = ∅) : False := by
  have hB_univ : PolygonCore.hullVertices S = Finset.univ := by
    ext x; simp only [Finset.mem_univ, iff_true]
    by_contra hx
    have hxA : x ∈ PolygonCore.interiorPoints S := Finset.mem_sdiff.mpr ⟨Finset.mem_univ x, hx⟩
    rw [hA] at hxA; exact Finset.notMem_empty x hxA
  obtain ⟨cb⟩ := PolygonCore.exists_cyclicSubsetBoundary hP
    (le_of_eq hB_univ.symm) (by decide)
  rcases cb with ⟨m, p_idx, hp_inj, hp_img, _, hcyc⟩
  have hm4 : m = 4 := by
    have hc1 := congrArg Finset.card hp_img
    rw [Finset.card_image_of_injective _ hp_inj, Finset.card_fin, Finset.card_fin] at hc1
    omega
  subst hm4
  let σ : Equiv.Perm (Fin 7) := Equiv.ofBijective p_idx (Finite.injective_iff_bijective.mp hp_inj)
  have hP' : ShatteredSimplePolygon P (relabelS σ S) (relabelW σ w) := shattered_relabel hP σ
  have hA' : PolygonCore.interiorPoints (relabelS σ S) = ∅ := by
    rw [Finset.eq_empty_iff_forall_notMem]
    intro i hi; rw [mem_interiorPoints_relabel, hA] at hi; exact Finset.notMem_empty _ hi
  have hH' : PolygonCore.certifiedSet P (relabelS σ S) (relabelW σ w) = ∅ := by
    rw [Finset.eq_empty_iff_forall_notMem]
    intro i hi; rw [mem_certifiedSet_relabel, hH] at hi; exact Finset.notMem_empty _ hi
  have hccw' : CCWConvexSeven (relabelS σ S) := by
    intro i j k h1 h2
    exact (orientSign_eq_true_iff _ _ _).mpr (hcyc i j k (cyclicOrder7_of_sub_lt i j k h1 h2))
  exact no_ccw_unmarked_convex_seven hP' hccw' hA' hH'

/-- **Theorem 3.2 (`simple_polygon_vcdim_le_eleven`, 100% Certificate-Free)**:
    Every simple polygon `P ⊂ ℝ²` has VC-dimension at most `11` (`∀ n ≥ 12, False`),
    proved directly from `unmarked_hull_slice_inheritance` + `no_unmarked_convex_seven_shattered`
    with zero SAT/RUP certificates! -/
theorem simple_polygon_vcdim_le_eleven {n : ℕ} (hn : 12 ≤ n)
    {P : Set (ℝ × ℝ)} {S : Fin n → ℝ × ℝ} {w : Finset (Fin n) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) : False :=
  vcdim_le_eleven_of_no_unmarked_convex_seven
    (fun S7 w7 hP7 hA7 hH7 => no_unmarked_convex_seven_shattered S7 w7 hP7 hA7 hH7) hn hP

end VCDim6

