/-! ## 1. Regimes of `w_★ = w Finset.univ` and Lemma 3.9(a)–(c) -/

/-- Regime `k = 0`: no witness `w_ι` satisfies Branch 2 (`IotaEscapes`). -/
def NoEscapeRegime (P : Set (ℝ × ℝ)) (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ) : Prop :=
  ∀ (ι : Fin 7) (tag : Fin 3) (s : Bool), ¬ IotaEscapes P S w ι tag s

/-- Regime `k ∈ {2, 3, 4, 5, 6}`: `w Finset.univ` lies outside `conv(S)` with facing edges `0 .. k - 1`. -/
def IsExteriorStar (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ) (k : ℕ) : Prop :=
  2 ≤ k ∧ k ≤ 6 ∧
  ∀ u : Fin 7, (orientSign (S u) (S (u + 1)) (w Finset.univ) = false ↔ u.val < k)

/-- Unified regime predicate (`k = 0` or `k ∈ {2..6}`). -/
def ValidSec3Regime (P : Set (ℝ × ℝ)) (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ) (k : ℕ) : Prop :=
  if k = 0 then NoEscapeRegime P S w else IsExteriorStar S w k

private lemma bool_ne_not' {b : Bool} (h : b = !b) : False :=
  (Bool.eq_not_self b).mp h

private lemma valt_ne_univ' (ι : Fin 7) : V_alt ι ≠ Finset.univ := by
  intro h; have : ι ∈ V_alt ι := h ▸ Finset.mem_univ ι; revert ι this; decide

private lemma fin7_subarc_lt (x y u : Fin 7) :
    x.val < y.val → 0 < (y - x).val ∧ ((u - x).val < (y - x).val → u.val < y.val) := by
  revert x y u; decide

private lemma fin7_add_sub_val (a x u : Fin 7) :
    (x - a).val + (u - x).val < 7 → (u - a).val = (x - a).val + (u - x).val := by
  revert a x u; decide

private lemma fin7_esc_arc_bounds (ι : Fin 7) (tag : Fin 3) (kf : Fin 7) :
    2 ≤ kf.val →
    (∀ u : Fin 7, (u - (chainEndpoints ι tag).1).val <
      ((chainEndpoints ι tag).2 - (chainEndpoints ι tag).1).val → u.val < kf.val) →
    (chainEndpoints ι tag).1.val + ((chainEndpoints ι tag).2 - (chainEndpoints ι tag).1).val ≤ kf.val ∧
    (chainEndpoints ι tag).2.val =
      (chainEndpoints ι tag).1.val + ((chainEndpoints ι tag).2 - (chainEndpoints ι tag).1).val ∧
    2 ≤ ((chainEndpoints ι tag).2 - (chainEndpoints ι tag).1).val := by
  fin_cases ι <;> fin_cases tag <;> fin_cases kf <;> decide

private lemma fin7_vc_imax_imin_eq (imax df kf : Fin 7) :
    2 ≤ kf.val →
    (∀ u : Fin 7, (u - imax).val < df.val ↔ u.val < kf.val) →
    imax = 0 ∧ finShift imax df.val = kf := by
  fin_cases imax <;> fin_cases df <;> fin_cases kf <;> decide

/-- Under `IsExteriorStar S w k`, every chord `(x, y)` with `0 ≤ x < y ≤ k` faces `w Finset.univ`. -/
lemma extStar_chord_false {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ} {w : Finset (Fin 7) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    {k : ℕ} (hext : IsExteriorStar S w k) {x y : Fin 7}
    (hxy : x.val < y.val) (hyk : y.val ≤ k) :
    orientSign (S x) (S y) (w Finset.univ) = false := by
  have h0 : 0 < (y - x).val := (fin7_subarc_lt x y 0 hxy).1
  refine facing_arc_chord_false hP hccw h0 (fun u hu => ?_)
  have huy : u.val < y.val := (fin7_subarc_lt x y u hxy).2 hu
  exact (hext.2.2 u).mpr (lt_of_lt_of_le huy hyk)

/-- **Lemma 3.9(b) (`extStar_front_excl`)**:
    Under `IsExteriorStar S w k`, if `(a, p, b)` is CCW and `FiresW0 P S w p a b`, then we cannot have
    `intrinsicPol S w p = true ∧ a.val < p.val ∧ p.val ≤ k`, nor
    `intrinsicPol S w p = false ∧ p.val < b.val ∧ b.val ≤ k`. -/
lemma extStar_front_excl {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ} {w : Finset (Fin 7) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    (hA : PolygonCore.interiorPoints S = ∅) (hH : PolygonCore.certifiedSet P S w = ∅)
    {k : ℕ} (hext : IsExteriorStar S w k) {a p b : Fin 7}
    (hp1 : 0 < (p - a).val) (hp2 : (p - a).val < (b - a).val)
    (hf : FiresW0 P S w p a b)
    (hcond : if intrinsicPol S w p then (a.val < p.val ∧ p.val ≤ k)
             else (p.val < b.val ∧ b.val ≤ k)) : False := by
  have hs := (firesW0_ccw_signs hP hccw hA hH hf hp1 hp2).1
  cases hp : intrinsicPol S w p <;> rw [hp] at hs hcond <;>
    simp only [Bool.false_eq_true, ↓reduceIte] at hs hcond
  · have hf_pb := extStar_chord_false hP hccw hext hcond.1 hcond.2
    rw [hs] at hf_pb; exact Bool.noConfusion hf_pb
  · have hf_ap := extStar_chord_false hP hccw hext hcond.1 hcond.2
    rw [hs] at hf_ap; exact Bool.noConfusion hf_ap

/-- **Lemma 3.9(a) (`extStar_tangent_only_escape`)**:
    Under `IsExteriorStar S w k`, any `IotaEscapes P S w ι tag_adj s` with chain `(a_e, b_e)` satisfies
    either `(s = true ∧ a_e = 0 ∧ (b_e - a_e).val ≤ k)` or
    `(s = false ∧ b_e.val = k ∧ a_e.val + (b_e - a_e).val = k)`. -/
lemma extStar_tangent_only_escape {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ} {w : Finset (Fin 7) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    {k : ℕ} (hext : IsExteriorStar S w k) {ι : Fin 7} {tag_adj : Fin 3} {s : Bool}
    (hesc : IotaEscapes P S w ι tag_adj s) :
    let ae := (chainEndpoints ι tag_adj).1
    let be := (chainEndpoints ι tag_adj).2
    (s = true ∧ ae = 0 ∧ (be - ae).val ≤ k) ∨
    (s = false ∧ be.val = k ∧ ae.val + (be - ae).val = k) := by
  let ae := (chainEndpoints ι tag_adj).1
  let be := (chainEndpoints ι tag_adj).2
  let m := if s then ae else be
  let kf : Fin 7 := ⟨k, by have := hext.2.1; omega⟩
  have harc_lt : ∀ u : Fin 7, (u - ae).val < (be - ae).val → u.val < kf.val := fun u hu =>
    (hext.2.2 u).mp (hesc.2.2 u hu).2
  obtain ⟨hsum_le, hbe_eq, hde_ge2⟩ := fin7_esc_arc_bounds ι tag_adj kf hext.1 harc_lt
  have h0_face : orientSign (S 0) (S (0 + 1)) (w Finset.univ) = false :=
    (hext.2.2 0).mpr (by have := hext.1; change 0 < k; omega)
  obtain ⟨vc⟩ := exists_vc_of_facing_edge hP hccw h0_face
  have hd_lt7 : vc.d_near < 7 := by
    by_contra hge
    have hlt6 : ((6 : Fin 7) - vc.i_max).val < vc.d_near :=
      lt_of_lt_of_le ((6 : Fin 7) - vc.i_max).isLt (Nat.le_of_not_lt hge)
    have hf6 := (vc_facing_iff hP vc 6).mpr hlt6
    have hk6 := (hext.2.2 6).mp hf6
    change 6 < k at hk6
    have := hext.2.1; omega
  let df : Fin 7 := ⟨vc.d_near, hd_lt7⟩
  have hiff_vc : ∀ u : Fin 7, (u - vc.i_max).val < df.val ↔ u.val < kf.val := fun u =>
    (vc_facing_iff hP vc u).symm.trans (hext.2.2 u)
  obtain ⟨himax0, himin_kf⟩ := fin7_vc_imax_imin_eq vc.i_max df kf hext.1 hiff_vc
  have himin_eq : vc.i_min = kf := vc.hmin_eq.symm.trans himin_kf
  have hm_or : m = 0 ∨ m = kf := by
    by_contra hnot; push Not at hnot
    rcases hnot with ⟨hm0, hmk⟩
    have hs0 : orientSign (w (V_alt ι)) (w Finset.univ) (S 0) = s := hesc.2.1 0 hm0.symm
    have hsk : orientSign (w (V_alt ι)) (w Finset.univ) (S kf) = s := hesc.2.1 kf hmk.symm
    have hsm : orientSign (w (V_alt ι)) (w Finset.univ) (S m) = !s := hesc.1
    have hTv_ne : V_alt ι ≠ Finset.univ := valt_ne_univ' ι
    have hm_ne_min : m ≠ vc.i_min := himin_eq ▸ hmk
    have hm_ne_max : m ≠ vc.i_max := himax0 ▸ hm0
    have hmin_lt : vc.slope vc.i_min < vc.slope m :=
      lt_of_le_of_ne (vc.h_extrema m).1 (fun h => hm_ne_min (vc.h_slope_inj h).symm)
    have hlt_max : vc.slope m < vc.slope vc.i_max :=
      lt_of_le_of_ne (vc.h_extrema m).2 (fun h => hm_ne_max (vc.h_slope_inj h))
    have o1 : 0 < orient2D (w Finset.univ) (S kf) (S m) := by
      rw [← himin_eq]; exact (vc.h_orient vc.i_min m).mpr hmin_lt
    have o2 : 0 < orient2D (w Finset.univ) (S m) (S 0) := by
      rw [← himax0]; exact (vc.h_orient m vc.i_max).mpr hlt_max
    have o3 : 0 < orient2D (w Finset.univ) (S kf) (S 0) := by
      rw [← himin_eq, ← himax0]; exact (vc.h_orient vc.i_min vc.i_max).mpr (lt_trans hmin_lt hlt_max)
    have hid : orient2D (w Finset.univ) (S kf) (S 0) * orient2D (w (V_alt ι)) (w Finset.univ) (S m) =
        orient2D (w Finset.univ) (S kf) (S m) * orient2D (w (V_alt ι)) (w Finset.univ) (S 0) +
        orient2D (w Finset.univ) (S m) (S 0) * orient2D (w (V_alt ι)) (w Finset.univ) (S kf) := by
      unfold orient2D; ring
    cases s
    · simp only [Bool.not_false] at hsm
      have l0 := (orientSign_eq_false_iff_of_ne_zero (orient_w_w_S_ne hP hTv_ne 0)).mp hs0
      have lk := (orientSign_eq_false_iff_of_ne_zero (orient_w_w_S_ne hP hTv_ne kf)).mp hsk
      have lm := (orientSign_eq_true_iff _ _ _).mp hsm
      nlinarith
    · simp only [Bool.not_true] at hsm
      have l0 := (orientSign_eq_true_iff _ _ _).mp hs0
      have lk := (orientSign_eq_true_iff _ _ _).mp hsk
      have lm := (orientSign_eq_false_iff_of_ne_zero (orient_w_w_S_ne hP hTv_ne m)).mp hsm
      nlinarith
  change (s = true ∧ ae = 0 ∧ (be - ae).val ≤ k) ∨ (s = false ∧ be.val = k ∧ ae.val + (be - ae).val = k)
  cases hs_b : s
  · right
    have hm_be : m = be := by dsimp [m]; simp [hs_b]
    rw [hm_be] at hm_or
    rcases hm_or with hbe0 | hbek
    · exfalso; have : be.val = 0 := congrArg Fin.val hbe0; omega
    · have hbek_val : be.val = k := congrArg Fin.val hbek
      exact ⟨rfl, hbek_val, by omega⟩
  · left
    have hm_ae : m = ae := by dsimp [m]; simp [hs_b]
    rw [hm_ae] at hm_or
    rcases hm_or with hae0 | haek
    · exact ⟨rfl, hae0, by change (be - ae).val ≤ kf.val; omega⟩
    · exfalso; have : ae.val = kf.val := congrArg Fin.val haek; omega

/-- **Lemma 3.9(c) (`extStar_escape_blocker`)**:
    Suppose `IotaEscapes P S w ι tag_adj s` holds on `[ae .. be]`, and a missed vertex `xm ∉ V_alt ι`
    satisfies `FiresW0 P S w xm ac bc` with `{ac, bc} ⊆ V_alt ι` and `(ac, xm, bc)` CCW.
    - If `intrinsicPol S w xm = true`, `[xm .. bc]` cannot be a sub-arc of `[ae .. be]`.
    - If `intrinsicPol S w xm = false`, `[ac .. xm]` cannot be a sub-arc of `[ae .. be]`. -/
lemma extStar_escape_blocker {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ} {w : Finset (Fin 7) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    (hA : PolygonCore.interiorPoints S = ∅) (hH : PolygonCore.certifiedSet P S w = ∅)
    {ι : Fin 7} {tag_adj : Fin 3} {s : Bool}
    (hesc : IotaEscapes P S w ι tag_adj s)
    {xm ac bc : Fin 7}
    (hxm_out : xm ∉ V_alt ι) (hab_in : ({ac, bc} : Finset (Fin 7)) ⊆ V_alt ι)
    (hc1 : 0 < (xm - ac).val) (hc2 : (xm - ac).val < (bc - ac).val)
    (hf : FiresW0 P S w xm ac bc)
    (hsub :
      let ae := (chainEndpoints ι tag_adj).1
      let be := (chainEndpoints ι tag_adj).2
      if intrinsicPol S w xm then
        0 < (bc - xm).val ∧ ∀ u : Fin 7, (u - xm).val < (bc - xm).val → (u - ae).val < (be - ae).val
      else
        0 < (xm - ac).val ∧ ∀ u : Fin 7, (u - ac).val < (xm - ac).val → (u - ae).val < (be - ae).val) :
    False := by
  have hs := (firesW0_ccw_signs hP hccw hA hH hf hc1 hc2).2 hab_in hxm_out
  cases hp : intrinsicPol S w xm <;> rw [hp] at hs hsub <;>
    simp only [Bool.false_eq_true, ↓reduceIte] at hs hsub
  · have hf_arc := facing_arc_chord_false hP hccw hsub.1 (fun u hu => (hesc.2.2 u (hsub.2 u hu)).1)
    rw [hs] at hf_arc; exact Bool.noConfusion hf_arc
  · have hf_arc := facing_arc_chord_false hP hccw hsub.1 (fun u hu => (hesc.2.2 u (hsub.2 u hu)).1)
    rw [hs] at hf_arc; exact Bool.noConfusion hf_arc


/-! ## 2. Pure-Kernel Deductive Proof Verifier (`Sec3Table` & `verifyFuel`) -/

def toF7 (x : ℕ) : Fin 7 := ⟨x % 7, Nat.mod_lt x (by decide)⟩
def toF3 (x : ℕ) : Fin 3 := ⟨x % 3, Nat.mod_lt x (by decide)⟩

def dist7 (a b : ℕ) : ℕ := (b % 7 + 7 - a % 7) % 7

def inValtB (iota x : ℕ) : Bool :=
  let d := dist7 iota x
  d == 1 || d == 3 || d == 5 || d == 6

def chainEndB (iota tag : ℕ) : ℕ × ℕ :=
  let i := iota % 7
  let t := tag % 3
  if t == 0 then (i, (i + 2) % 7)
  else if t == 1 then ((i + 2) % 7, (i + 4) % 7)
  else ((i + 4) % 7, i)

def chainOppB (iota tag : ℕ) : ℕ :=
  let i := iota % 7
  let t := tag % 3
  if t == 0 then (i + 4) % 7
  else if t == 1 then i
  else (i + 2) % 7

def chainInnersB (iota tag : ℕ) : List (ℕ × ℕ × ℕ) :=
  let a := (chainEndB iota tag).1
  let b := (chainEndB iota tag).2
  if dist7 a b == 2 then [((a + 1) % 7, a, b)]
  else [((a + 1) % 7, a, b), ((a + 2) % 7, a, b)]

def subArcB (x y ae be : ℕ) : Bool :=
  let dxy := dist7 x y
  let dae := dist7 ae be
  Nat.ble 1 dxy && Nat.ble (dist7 ae x + dxy) dae

def hasFire (known : List (ℕ × ℕ × ℕ)) (p a b : ℕ) : Bool :=
  let fp := p % 7
  let fa := a % 7
  let fb := b % 7
  known.any (fun t =>
    t.1 % 7 == fp &&
    ((t.2.1 % 7 == fa && t.2.2 % 7 == fb) || (t.2.1 % 7 == fb && t.2.2 % 7 == fa)))

def polBit (pm x : ℕ) : Bool :=
  (pm >>> (x % 7)) % 2 == 1

def strictNat {α : Type} (n : ℕ) (k : ℕ → α) : α :=
  @Nat.rec (fun _ => α) (k 0) (fun m _ => k (Nat.succ m)) n

def popTok (w : ℕ) : ℕ × ℕ :=
  strictNat (Nat.mod w 32) (fun r =>
    match Nat.beq r 0 with
    | true => (99, 0)
    | false => strictNat (Nat.div w 32) (fun q => (Nat.sub r 1, q)))

def chainSeq (f1 f2 : ℕ → Bool × ℕ) (w : ℕ) : Bool × ℕ :=
  let r1 := f1 w
  if r1.1 then f2 r1.2 else (false, r1.2)

inductive Sec3Mode : Type where
  | root : Sec3Mode
  | fire (allowLaw2 : Bool) (fi tag : ℕ) (s : Bool) : Sec3Mode
  | esc (fi tag : ℕ) (s : Bool) : Sec3Mode

def verifyFuel : ℕ → Sec3Mode → ℕ → ℕ → List (ℕ × ℕ × ℕ) → ℕ → Bool × ℕ
  | 0, _, _, _, _, w => (false, w)
  | fuel + 1, .root, k, pm, known, w =>
    let (op, w1) := popTok w
    if op == 1 then
      let (x0, w2) := popTok w1
      let x := x0 % 7
      let ok := (polBit pm x == polBit pm ((x + 1) % 7)) &&
        hasFire known x ((x + 6) % 7) ((x + 1) % 7) &&
        hasFire known ((x + 1) % 7) x ((x + 2) % 7)
      (ok, w2)
    else if op == 2 then
      let (a, w2) := popTok w1
      let (b, w3) := popTok w2
      let (p0, w4) := popTok w3
      let (p1, w5) := popTok w4
      let (p2, w6) := popTok w5
      let ok := (p0 % 7 != p1 % 7) && (p0 % 7 != p2 % 7) && (p1 % 7 != p2 % 7) &&
        hasFire known p0 a b && hasFire known p1 a b && hasFire known p2 a b
      (ok, w6)
    else if op == 3 then
      let (a, w2) := popTok w1
      let (p, w3) := popTok w2
      let (b, w4) := popTok w3
      let fa := a % 7; let fp := p % 7; let fb := b % 7
      let condPol := if polBit pm fp then (Nat.ble (fa + 1) fp && Nat.ble fp k)
                     else (Nat.ble (fp + 1) fb && Nat.ble fb k)
      let ok := Nat.ble 2 k && Nat.ble k 6 &&
        Nat.ble 1 (dist7 fa fp) && Nat.ble (dist7 fa fp + 1) (dist7 fa fb) &&
        hasFire known fp fa fb && condPol
      (ok, w4)
    else if op == 4 || op == 5 then
      let (p, w2) := popTok w1
      let (q, w3) := popTok w2
      let (ap, w4) := popTok w3
      let (bp, w5) := popTok w4
      let (aq, w6) := popTok w5
      let (bq, w7) := popTok w6
      let (r, w8) := popTok w7
      let fp := p % 7; let fq := q % 7; let fap := ap % 7; let fbp := bp % 7
      let faq := aq % 7; let fbq := bq % 7; let fr := r % 7
      let baseOk := Nat.ble 2 (dist7 fp fq) && Nat.ble (dist7 fp fq) 3 &&
        (fq != fap) && (fq != fbp) && (fp != faq) && (fp != fbq) &&
        Nat.ble 1 (dist7 fp fr) && Nat.ble (dist7 fp fr + 1) (dist7 fp fq) &&
        (polBit pm fp == polBit pm fq) &&
        hasFire known fp fap fbp && hasFire known fq faq fbq
      if !baseOk then (false, w8)
      else if op == 4 then (polBit pm fr == polBit pm fp, w8)
      else verifyFuel fuel .root k pm ((fr, fp, fq) :: known) w8
    else if op == 6 then
      let (iota, wc0) := popTok w1
      let fi := iota % 7
      chainSeq (verifyFuel fuel (.fire true fi 0 false) k pm known) (
      chainSeq (verifyFuel fuel (.fire true fi 0 true)  k pm known) (
      chainSeq (verifyFuel fuel (.fire true fi 1 false) k pm known) (
      chainSeq (verifyFuel fuel (.fire true fi 1 true)  k pm known) (
      chainSeq (verifyFuel fuel (.fire true fi 2 false) k pm known) (
      chainSeq (verifyFuel fuel (.fire true fi 2 true)  k pm known) (
      chainSeq (verifyFuel fuel (.esc fi 0 false) k pm known) (
      chainSeq (verifyFuel fuel (.esc fi 0 true)  k pm known) (
      chainSeq (verifyFuel fuel (.esc fi 1 false) k pm known) (
      chainSeq (verifyFuel fuel (.esc fi 1 true)  k pm known) (
      chainSeq (verifyFuel fuel (.esc fi 2 false) k pm known)
               (verifyFuel fuel (.esc fi 2 true)  k pm known))))))))))) wc0
    else (false, w1)
  | fuel + 1, .fire allowLaw2 fi tag s, k, pm, known, w =>
    let (op, w1) := popTok w
    let a := (chainEndB fi tag).1
    let b := (chainEndB fi tag).2
    if op == 10 then
      let (p, w2) := popTok w1
      let fp := p % 7
      let ok := Nat.ble 1 (dist7 a fp) && Nat.ble (dist7 a fp + 1) (dist7 a b) &&
        (polBit pm fp != s)
      (ok, w2)
    else if op == 11 then
      let (x, w2) := popTok w1
      let (u, w3) := popTok w2
      let (v, w4) := popTok w3
      let fx := x % 7; let fu := u % 7; let fv := v % 7
      let ok := ((fx == a) || (fx == b)) && inValtB fi fu && inValtB fi fv &&
        !inValtB fi fx && hasFire known fx fu fv && ((!polBit pm fx) != s)
      (ok, w4)
    else if op == 12 then
      if !allowLaw2 then (false, w1)
      else
        let (u, w2) := popTok w1
        let (v, w3) := popTok w2
        let fu := u % 7; let fv := v % 7
        let m3 := chainOppB fi tag
        if !(inValtB fi fu && inValtB fi fv && hasFire known m3 fu fv && (polBit pm m3 == !s)) then
          (false, w3)
        else
          let known2 := chainInnersB fi tag ++ known
          chainSeq (verifyFuel fuel (.fire false fi ((tag + 1) % 3) s) k pm known2)
                   (verifyFuel fuel (.fire false fi ((tag + 2) % 3) s) k pm known2) w3
    else if op == 13 then
      let known2 := chainInnersB fi tag ++ known
      verifyFuel fuel .root k pm known2 w1
    else (false, w1)
  | fuel + 1, .esc fi tag s, k, pm, known, w =>
    let (op, w1) := popTok w
    let ae := (chainEndB fi tag).1
    let be := (chainEndB fi tag).2
    let de := dist7 ae be
    let m := if s then ae else be
    if op == 20 then (k == 0, w1)
    else if op == 21 then
      let tangOk := if s then ((ae == 0) && Nat.ble de k)
                    else ((be == k) && (ae + de == k))
      (Nat.ble 2 k && Nat.ble k 6 && !tangOk, w1)
    else if op == 22 then
      let (xm, w2) := popTok w1
      let (u, w3) := popTok w2
      let (v, w4) := popTok w3
      let fxm := xm % 7; let fu := u % 7; let fv := v % 7
      let expS := if fxm == m then !s else s
      let ok := !inValtB fi fxm && inValtB fi fu && inValtB fi fv &&
        hasFire known fxm fu fv && ((!polBit pm fxm) != expS)
      (ok, w4)
    else if op == 23 then
      let (xm, w2) := popTok w1
      let (ac, w3) := popTok w2
      let (bc, w4) := popTok w3
      let fxm := xm % 7; let fac := ac % 7; let fbc := bc % 7
      let subOk := if polBit pm fxm then subArcB fxm fbc ae be else subArcB fac fxm ae be
      let ok := !inValtB fi fxm && inValtB fi fac && inValtB fi fbc &&
        Nat.ble 1 (dist7 fac fxm) && Nat.ble (dist7 fac fxm + 1) (dist7 fac fbc) &&
        hasFire known fxm fac fbc && subOk
      (ok, w4)
    else if op == 24 then
      verifyFuel fuel .root k pm known w1
    else (false, w1)

inductive Sec3Table : Type where
  | empty : Sec3Table
  | leaf (w : ℕ) : Sec3Table
  | branch (l r : Sec3Table) : Sec3Table

def sec3Get : ℕ → ℕ → Sec3Table → ℕ
  | 0, _, .leaf w => w
  | d + 1, off, .branch l r =>
    let half := 1 <<< d
    if off < half then sec3Get d off l else sec3Get d (off - half) r
  | _, _, _ => 0

def kOfIdx : ℕ → ℕ
  | 0 => 0
  | 1 => 2
  | 2 => 3
  | 3 => 4
  | 4 => 5
  | _ => 6

def checkSec3Table : ℕ → ℕ → Sec3Table → Bool
  | _, base, .empty => Nat.ble 768 base
  | 0, idx, .leaf w =>
    if Nat.ble 768 idx then true
    else (verifyFuel 32 .root (kOfIdx (idx / 128)) (idx % 128) [] w).1
  | d + 1, base, .branch l r =>
    checkSec3Table d base l && checkSec3Table d (base + (1 <<< d)) r
  | _, _, _ => false

/-! ## 3. Soundness of `verifyFuel` and `checkSec3Table` -/

def KnownSound (P : Set (ℝ × ℝ)) (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ)
    (known : List (ℕ × ℕ × ℕ)) : Prop :=
  ∀ t ∈ known, FiresW0 P S w (toF7 t.1) (toF7 t.2.1) (toF7 t.2.2)

def ModeHyp (P : Set (ℝ × ℝ)) (S : Fin 7 → ℝ × ℝ) (w : Finset (Fin 7) → ℝ × ℝ) :
    Sec3Mode → Prop
  | .root => True
  | .fire _ fi tag s => IotaFiresChain P S w (toF7 fi) (toF3 tag) s
  | .esc fi tag s => IotaEscapes P S w (toF7 fi) (toF3 tag) s

@[simp] private lemma toF7_mod (x : ℕ) : toF7 (x % 7) = toF7 x := by
  ext; exact Nat.mod_mod x 7

@[simp] private lemma toF7_val (x : Fin 7) : toF7 x.val = x := by
  ext; exact Nat.mod_eq_of_lt x.isLt

@[simp] private lemma toF7_val_mod (x : ℕ) : (toF7 x).val = x % 7 := rfl

@[simp] private lemma toF3_mod (x : ℕ) : toF3 (x % 3) = toF3 x := by
  ext; exact Nat.mod_mod x 3

@[simp] private lemma toF3_val (x : Fin 3) : toF3 x.val = x := by
  ext; exact Nat.mod_eq_of_lt x.isLt

private lemma toF7_shifts (fx : Fin 7) :
    toF7 (fx.val + 1) = fx + 1 ∧
    toF7 (fx.val + 6) = fx - 1 ∧
    toF7 (fx.val + 2) = fx + 2 := by
  fin_cases fx <;> decide

private lemma dist7_eq_sub_val (fa fb : Fin 7) :
    dist7 fa.val fb.val = (fb - fa).val := by
  fin_cases fa <;> fin_cases fb <;> decide

private lemma dist7_mod_eq (a b : ℕ) :
    dist7 (a % 7) (b % 7) = ((toF7 b) - (toF7 a)).val :=
  dist7_eq_sub_val (toF7 a) (toF7 b)

private lemma dist7_raw_eq (a b : ℕ) :
    dist7 a b = ((toF7 b) - (toF7 a)).val := by
  have h1 : dist7 a b = dist7 (a % 7) (b % 7) := by unfold dist7; simp [Nat.mod_mod]
  rw [h1, dist7_mod_eq]

private lemma inValtB_raw_iff (fi x : ℕ) :
    inValtB fi x = true ↔ toF7 x ∈ V_alt (toF7 fi) := by
  have hm : inValtB fi x = inValtB (toF7 fi).val (toF7 x).val := by
    unfold inValtB dist7; simp [toF7, Nat.mod_mod]
  rw [hm]
  generalize toF7 fi = a; generalize toF7 x = b
  fin_cases a <;> fin_cases b <;> decide

private lemma inValtB_raw_false_iff (fi x : ℕ) :
    inValtB fi x = false ↔ toF7 x ∉ V_alt (toF7 fi) := by
  cases hb : inValtB fi x
  · simp only [true_iff]; intro hm; exact Bool.noConfusion (hb.symm.trans ((inValtB_raw_iff fi x).mpr hm))
  · simp only [Bool.true_eq_false, false_iff, not_not]; exact (inValtB_raw_iff fi x).mp hb

private lemma polBit_mod (pm x : ℕ) :
    polBit pm (x % 7) = polBit pm (toF7 x).val := rfl

private lemma polBit_raw (pm x : ℕ) :
    polBit pm (toF7 x).val = polBit pm x := by
  unfold polBit toF7; simp [Nat.mod_mod]

private lemma chainEndB_mod (fi tag : ℕ) :
    chainEndB (fi % 7) (tag % 3) = chainEndB fi tag := by
  unfold chainEndB; simp [Nat.mod_mod]

private lemma chainOppB_mod (fi tag : ℕ) :
    chainOppB (fi % 7) (tag % 3) = chainOppB fi tag := by
  unfold chainOppB; simp [Nat.mod_mod]

private lemma chainInnersB_mod (fi tag : ℕ) :
    chainInnersB (fi % 7) (tag % 3) = chainInnersB fi tag := by
  unfold chainInnersB; rw [chainEndB_mod]

private lemma chainEndB_eq (fi : Fin 7) (tag : Fin 3) :
    chainEndB fi.val tag.val = ((chainEndpoints fi tag).1.val, (chainEndpoints fi tag).2.val) := by
  fin_cases fi <;> fin_cases tag <;> decide

private lemma chainOppB_eq (fi : Fin 7) (tag : Fin 3) :
    toF7 (chainOppB fi.val tag.val) = chainOppositeMissed fi tag := by
  fin_cases fi <;> fin_cases tag <;> decide

private lemma chainInnersB_props (fi : Fin 7) (tag : Fin 3) (t : ℕ × ℕ × ℕ) :
    t ∈ chainInnersB fi.val tag.val →
      toF7 t.2.1 = (chainEndpoints fi tag).1 ∧
      toF7 t.2.2 = (chainEndpoints fi tag).2 ∧
      0 < (toF7 t.1 - (chainEndpoints fi tag).1).val ∧
      (toF7 t.1 - (chainEndpoints fi tag).1).val <
        ((chainEndpoints fi tag).2 - (chainEndpoints fi tag).1).val := by
  revert t; fin_cases fi <;> fin_cases tag <;> decide

private lemma fin3_ne_succ_or_add2' (t1 t2 : Fin 3) :
    t1 ≠ t2 → t1 = toF3 (t2.val + 1) ∨ t1 = toF3 (t2.val + 2) := by
  fin_cases t1 <;> fin_cases t2 <;> decide

private lemma chainSeq_true {f1 f2 : ℕ → Bool × ℕ} {w : ℕ}
    (h : (chainSeq f1 f2 w).1 = true) :
    (f1 w).1 = true ∧ (f2 (f1 w).2).1 = true := by
  unfold chainSeq at h
  cases h1 : (f1 w).1
  · simp [h1] at h
  · exact ⟨rfl, by simpa [h1] using h⟩

private lemma hasFire_sound {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ} {w : Finset (Fin 7) → ℝ × ℝ}
    {known : List (ℕ × ℕ × ℕ)} (hK : KnownSound P S w known) {p a b : ℕ}
    (h : hasFire known p a b = true) :
    FiresW0 P S w (toF7 p) (toF7 a) (toF7 b) := by
  unfold hasFire at h
  obtain ⟨t, ht_mem, ht_ok⟩ := List.any_eq_true.mp h
  have hf := hK t ht_mem
  simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at ht_ok
  have hp_eq : toF7 t.1 = toF7 p := Fin.ext ht_ok.1
  rcases ht_ok.2 with ⟨ha, hb⟩ | ⟨hb, ha⟩
  · have ha_eq : toF7 t.2.1 = toF7 a := Fin.ext ha
    have hb_eq : toF7 t.2.2 = toF7 b := Fin.ext hb
    rwa [← hp_eq, ← ha_eq, ← hb_eq]
  · have hb_eq : toF7 t.2.1 = toF7 b := Fin.ext hb
    have ha_eq : toF7 t.2.2 = toF7 a := Fin.ext ha
    exact firesW0_symm (by rwa [← hp_eq, ← hb_eq, ← ha_eq])

private lemma subArcB_sound (fx fy fae fbe : Fin 7)
    (h : subArcB fx.val fy.val fae.val fbe.val = true) :
    0 < (fy - fx).val ∧
    ∀ u : Fin 7, (u - fx).val < (fy - fx).val → (u - fae).val < (fbe - fae).val := by
  unfold subArcB at h
  simp only [Bool.and_eq_true, Nat.ble_eq, dist7_eq_sub_val] at h
  refine ⟨h.1, fun u hu => ?_⟩
  have hlt7 : (fbe - fae).val < 7 := (fbe - fae).isLt
  have heq := fin7_add_sub_val fae fx u (by omega)
  omega

private lemma pair_subset_of_mem {α : Type*} [DecidableEq α] {u v : α} {A : Finset α}
    (hu : u ∈ A) (hv : v ∈ A) : ({u, v} : Finset α) ⊆ A := by
  intro z hz; simp only [Finset.mem_insert, Finset.mem_singleton] at hz
  rcases hz with rfl | rfl <;> assumption

private lemma not_mem_pair_of_ne {α : Type*} [DecidableEq α] {q a b : α}
    (h1 : q ≠ a) (h2 : q ≠ b) : q ∉ ({a, b} : Finset α) := by
  simp [h1, h2]

theorem verifyFuel_sound {P : Set (ℝ × ℝ)} {S : Fin 7 → ℝ × ℝ} {w : Finset (Fin 7) → ℝ × ℝ}
    (hP : ShatteredSimplePolygon P S w) (hccw : CCWConvexSeven S)
    (hA : PolygonCore.interiorPoints S = ∅) (hH : PolygonCore.certifiedSet P S w = ∅)
    {k pm : ℕ} (hReg : ValidSec3Regime P S w k)
    (hPol : ∀ x : Fin 7, polBit pm x.val = intrinsicPol S w x) :
    ∀ (fuel : ℕ) (mode : Sec3Mode) (known : List (ℕ × ℕ × ℕ)) (wStream : ℕ),
      KnownSound P S w known →
      ModeHyp P S w mode →
      (verifyFuel fuel mode k pm known wStream).1 = true →
      False := by
  intro fuel
  induction fuel with
  | zero => intro _ _ _ _ _ h; exact Bool.noConfusion h
  | succ fuel ih =>
    intro mode known wStream hK hM h
    cases mode with
    | root =>
      unfold verifyFuel at h
      rcases hpop0 : popTok wStream with ⟨op, w1⟩
      rw [hpop0] at h; dsimp only at h
      by_cases hop1 : op == 1
      · rw [hop1] at h
        rcases hpop1 : popTok w1 with ⟨x0, w2⟩
        rw [hpop1] at h
        simp only [↓reduceIte, Bool.and_eq_true, beq_iff_eq] at h
        rcases h with ⟨⟨hp_eq, hf1_b⟩, hf2_b⟩
        have sh := toF7_shifts (toF7 x0)
        have hpol_eq : intrinsicPol S w (toF7 x0) = intrinsicPol S w (toF7 x0 + 1) := by
          rw [← hPol (toF7 x0), ← hPol (toF7 x0 + 1), ← sh.1]
          exact hp_eq
        have hf1 := hasFire_sound hK hf1_b
        have hf2 := hasFire_sound hK hf2_b
        rw [toF7_mod, toF7_mod, toF7_mod, ← toF7_val_mod x0, sh.2.1, sh.1] at hf1
        rw [toF7_mod, toF7_mod, toF7_mod, ← toF7_val_mod x0, sh.1, sh.2.2] at hf2
        exact adj_equal_sign_excl hP hpol_eq hf1 hf2
      · rw [Bool.eq_false_iff.mpr hop1] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
        by_cases hop2 : op == 2
        · rw [hop2] at h
          rcases hpop1 : popTok w1 with ⟨a, w2⟩
          rcases hpop2 : popTok w2 with ⟨b, w3⟩
          rcases hpop3 : popTok w3 with ⟨p0, w4⟩
          rcases hpop4 : popTok w4 with ⟨p1, w5⟩
          rcases hpop5 : popTok w5 with ⟨p2, w6⟩
          rw [hpop1, hpop2, hpop3, hpop4, hpop5] at h
          simp only [↓reduceIte, Bool.and_eq_true, bne_iff_ne] at h
          rcases h with ⟨⟨⟨⟨⟨c01, c02⟩, c12⟩, f0⟩, f1⟩, f2⟩
          exact firesW0_capacity_le_two hP
            (fun e => c01 (congrArg Fin.val e))
            (fun e => c02 (congrArg Fin.val e))
            (fun e => c12 (congrArg Fin.val e))
            (hasFire_sound hK f0) (hasFire_sound hK f1) (hasFire_sound hK f2)
        · rw [Bool.eq_false_iff.mpr hop2] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
          by_cases hop3 : op == 3
          · rw [hop3] at h
            rcases hpop1 : popTok w1 with ⟨a, w2⟩
            rcases hpop2 : popTok w2 with ⟨p, w3⟩
            rcases hpop3 : popTok w3 with ⟨b, w4⟩
            rw [hpop1, hpop2, hpop3] at h
            simp only [↓reduceIte, Bool.and_eq_true, Nat.ble_eq, dist7_mod_eq] at h
            rcases h with ⟨⟨⟨⟨⟨hk2, _⟩, hd1⟩, hd2⟩, hf_b⟩, hc⟩
            have hext : IsExteriorStar S w k := by
              dsimp [ValidSec3Regime] at hReg; rwa [if_neg (by omega)] at hReg
            have hf := hasFire_sound hK hf_b
            rw [toF7_mod, toF7_mod, toF7_mod] at hf
            rw [polBit_mod, hPol (toF7 p)] at hc
            refine extStar_front_excl hP hccw hA hH hext (by omega) (by omega) hf ?_
            cases hip : intrinsicPol S w (toF7 p) <;> rw [hip] at hc <;>
              simp only [Bool.false_eq_true, if_false, if_true, Bool.and_eq_true, Nat.ble_eq] at hc ⊢
            · exact ⟨hc.1, hc.2⟩
            · exact ⟨hc.1, hc.2⟩
          · rw [Bool.eq_false_iff.mpr hop3] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
            by_cases hop45 : (op == 4 || op == 5) = true
            · rw [hop45] at h; simp only [↓reduceIte] at h
              rcases hpop1 : popTok w1 with ⟨p, w2⟩
              rcases hpop2 : popTok w2 with ⟨q, w3⟩
              rcases hpop3 : popTok w3 with ⟨ap, w4⟩
              rcases hpop4 : popTok w4 with ⟨bp, w5⟩
              rcases hpop5 : popTok w5 with ⟨aq, w6⟩
              rcases hpop6 : popTok w6 with ⟨bq, w7⟩
              rcases hpop7 : popTok w7 with ⟨r, w8⟩
              rw [hpop1, hpop2, hpop3, hpop4, hpop5, hpop6, hpop7] at h
              dsimp only at h
              split_ifs at h with hnot_base hop4
              · simp only [Bool.not_eq_true', Bool.eq_false_iff, Classical.not_not,
                  Bool.and_eq_true, Nat.ble_eq, bne_iff_ne, beq_iff_eq, dist7_mod_eq] at hnot_base h
                rcases hnot_base with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hlo, hhi⟩, hq_ap⟩, hq_bp⟩, hp_aq⟩, hp_bq⟩, hr1⟩, hr2⟩, hpq_pol⟩, hfp_b⟩, hfq_b⟩
                have hfp := hasFire_sound hK hfp_b
                have hfq := hasFire_sound hK hfq_b
                rw [toF7_mod, toF7_mod, toF7_mod] at hfp hfq
                have hpol_pq : intrinsicPol S w (toF7 p) = intrinsicPol S w (toF7 q) := by
                  rw [← hPol (toF7 p), ← hPol (toF7 q)]; exact hpq_pol
                have hlaw1 := master_law_I hP hccw hA hH hlo hhi hfp hfq
                  (not_mem_pair_of_ne (fun e => hq_ap (congrArg Fin.val e)) (fun e => hq_bp (congrArg Fin.val e)))
                  (not_mem_pair_of_ne (fun e => hp_aq (congrArg Fin.val e)) (fun e => hp_bq (congrArg Fin.val e)))
                  rfl hpol_pq.symm (toF7 r) (by omega) (by omega)
                have hpol_rp : intrinsicPol S w (toF7 r) = intrinsicPol S w (toF7 p) := by
                  rw [← hPol (toF7 r), ← hPol (toF7 p)]; exact h
                rw [hpol_rp] at hlaw1
                exact bool_ne_not' hlaw1.2
              · simp only [Bool.not_eq_true', Bool.eq_false_iff, Classical.not_not,
                  Bool.and_eq_true, Nat.ble_eq, bne_iff_ne, beq_iff_eq, dist7_mod_eq] at hnot_base
                rcases hnot_base with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hlo, hhi⟩, hq_ap⟩, hq_bp⟩, hp_aq⟩, hp_bq⟩, hr1⟩, hr2⟩, hpq_pol⟩, hfp_b⟩, hfq_b⟩
                have hfp := hasFire_sound hK hfp_b
                have hfq := hasFire_sound hK hfq_b
                rw [toF7_mod, toF7_mod, toF7_mod] at hfp hfq
                have hpol_pq : intrinsicPol S w (toF7 p) = intrinsicPol S w (toF7 q) := by
                  rw [← hPol (toF7 p), ← hPol (toF7 q)]; exact hpq_pol
                have hlaw1 := master_law_I hP hccw hA hH hlo hhi hfp hfq
                  (not_mem_pair_of_ne (fun e => hq_ap (congrArg Fin.val e)) (fun e => hq_bp (congrArg Fin.val e)))
                  (not_mem_pair_of_ne (fun e => hp_aq (congrArg Fin.val e)) (fun e => hp_bq (congrArg Fin.val e)))
                  rfl hpol_pq.symm (toF7 r) (by omega) (by omega)
                have hK' : KnownSound P S w ((r % 7, p % 7, q % 7) :: known) := by
                  intro t ht
                  rcases List.mem_cons.mp ht with rfl | ht'
                  · simpa only [toF7_mod] using hlaw1.1
                  · exact hK t ht'
                exact ih .root _ w8 hK' trivial h
            · rw [Bool.eq_false_iff.mpr hop45] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
              cases hop6 : (op == 6)
              · rw [hop6] at h; exact Bool.noConfusion h
              · rw [hop6] at h
                rcases hpop1 : popTok w1 with ⟨iota, wc0⟩
                rw [hpop1] at h; simp only [↓reduceIte] at h
                have ⟨b1, h⟩ := chainSeq_true h
                have ⟨b2, h⟩ := chainSeq_true h
                have ⟨b3, h⟩ := chainSeq_true h
                have ⟨b4, h⟩ := chainSeq_true h
                have ⟨b5, h⟩ := chainSeq_true h
                have ⟨b6, h⟩ := chainSeq_true h
                have ⟨b7, h⟩ := chainSeq_true h
                have ⟨b8, h⟩ := chainSeq_true h
                have ⟨b9, h⟩ := chainSeq_true h
                have ⟨b10, h⟩ := chainSeq_true h
                have ⟨b11, b12⟩ := chainSeq_true h
                rcases alt_witness_dichotomy hP hccw hA hH (toF7 (iota % 7)) with ⟨tag, s, hfire⟩ | ⟨tag, s, hesc⟩
                · fin_cases tag <;> cases s
                  · exact ih (.fire true (iota % 7) 0 false) known _ hK hfire b1
                  · exact ih (.fire true (iota % 7) 0 true)  known _ hK hfire b2
                  · exact ih (.fire true (iota % 7) 1 false) known _ hK hfire b3
                  · exact ih (.fire true (iota % 7) 1 true)  known _ hK hfire b4
                  · exact ih (.fire true (iota % 7) 2 false) known _ hK hfire b5
                  · exact ih (.fire true (iota % 7) 2 true)  known _ hK hfire b6
                · fin_cases tag <;> cases s
                  · exact ih (.esc (iota % 7) 0 false) known _ hK hesc b7
                  · exact ih (.esc (iota % 7) 0 true)  known _ hK hesc b8
                  · exact ih (.esc (iota % 7) 1 false) known _ hK hesc b9
                  · exact ih (.esc (iota % 7) 1 true)  known _ hK hesc b10
                  · exact ih (.esc (iota % 7) 2 false) known _ hK hesc b11
                  · exact ih (.esc (iota % 7) 2 true)  known _ hK hesc b12
    | fire allowLaw2 fi tag s =>
      have hfire : IotaFiresChain P S w (toF7 fi) (toF3 tag) s := hM
      have hce_eq : chainEndB fi tag =
          ((chainEndpoints (toF7 fi) (toF3 tag)).1.val, (chainEndpoints (toF7 fi) (toF3 tag)).2.val) :=
        (chainEndB_mod fi tag).symm.trans (chainEndB_eq (toF7 fi) (toF3 tag))
      have hKnown2 : KnownSound P S w (chainInnersB fi tag ++ known) := by
        intro t ht
        rcases List.mem_append.mp ht with ht_in | ht_old
        · have ht_in' : t ∈ chainInnersB (toF7 fi).val (toF3 tag).val := by
            change t ∈ chainInnersB (fi % 7) (tag % 3); rwa [chainInnersB_mod]
          obtain ⟨ha_eq, hb_eq, hp1, hp2⟩ := chainInnersB_props (toF7 fi) (toF3 tag) t ht_in'
          rw [ha_eq, hb_eq]
          exact (hfire.2.2 (toF7 t.1) hp1 hp2).1
        · exact hK t ht_old
      unfold verifyFuel at h
      rcases hpop0 : popTok wStream with ⟨op, w1⟩
      rw [hpop0] at h; dsimp only at h
      by_cases hop10 : op == 10
      · rw [hop10] at h
        rcases hpop1 : popTok w1 with ⟨p, w2⟩
        rw [hpop1, hce_eq] at h
        simp only [↓reduceIte, Bool.and_eq_true, Nat.ble_eq, bne_iff_ne] at h
        rcases h with ⟨⟨hd1, hd2⟩, hne⟩
        rw [dist7_raw_eq, toF7_mod, toF7_val] at hd1
        rw [dist7_raw_eq, dist7_raw_eq, toF7_mod, toF7_val, toF7_val] at hd2
        have hpol_s := (hfire.2.2 (toF7 p) (by omega) (by omega)).2.1
        rw [polBit_mod, hPol (toF7 p), hpol_s] at hne
        exact hne rfl
      · rw [Bool.eq_false_iff.mpr hop10] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
        by_cases hop11 : op == 11
        · rw [hop11] at h
          rcases hpop1 : popTok w1 with ⟨x, w2⟩
          rcases hpop2 : popTok w2 with ⟨u, w3⟩
          rcases hpop3 : popTok w3 with ⟨v, w4⟩
          rw [hpop1, hpop2, hpop3, hce_eq] at h
          simp only [↓reduceIte, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true',
            beq_iff_eq, bne_iff_ne] at h
          rcases h with ⟨⟨⟨⟨⟨hor, hfu_b⟩, hfv_b⟩, hfx_b⟩, hf_b⟩, hne⟩
          have hfx_or : toF7 x = (chainEndpoints (toF7 fi) (toF3 tag)).1 ∨
              toF7 x = (chainEndpoints (toF7 fi) (toF3 tag)).2 := by
            rcases hor with h1 | h2
            · exact Or.inl (Fin.ext h1)
            · exact Or.inr (Fin.ext h2)
          have hfu_in : toF7 u ∈ V_alt (toF7 fi) := by
            have := (inValtB_raw_iff fi (u % 7)).mp hfu_b; rwa [toF7_mod] at this
          have hfv_in : toF7 v ∈ V_alt (toF7 fi) := by
            have := (inValtB_raw_iff fi (v % 7)).mp hfv_b; rwa [toF7_mod] at this
          have hfx_out : toF7 x ∉ V_alt (toF7 fi) := by
            have := (inValtB_raw_false_iff fi (x % 7)).mp hfx_b; rwa [toF7_mod] at this
          have hf_x := hasFire_sound hK hf_b
          rw [toF7_mod, toF7_mod, toF7_mod] at hf_x
          have hsign := law_05_star_sign hP hf_x (pair_subset_of_mem hfu_in hfv_in) hfx_out
          have hs_x : orientSign (w (V_alt (toF7 fi))) (w Finset.univ) (S (toF7 x)) = s := by
            rcases hfx_or with h1 | h2
            · rw [h1]; exact hfire.1
            · rw [h2]; exact hfire.2.1
          rw [hs_x] at hsign
          rw [polBit_mod, hPol (toF7 x), ← hsign] at hne
          exact hne rfl
        · rw [Bool.eq_false_iff.mpr hop11] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
          by_cases hop12 : op == 12
          · rw [hop12] at h; simp only [↓reduceIte] at h
            cases hal : allowLaw2
            · simp [hal] at h
            · simp only [hal, Bool.not_true, Bool.false_eq_true, ↓reduceIte] at h
              rcases hpop1 : popTok w1 with ⟨u, w2⟩
              rcases hpop2 : popTok w2 with ⟨v, w3⟩
              rw [hpop1, hpop2] at h; dsimp only at h
              split_ifs at h with hnot12
              simp only [Bool.not_eq_true', Bool.eq_false_iff, Classical.not_not,
                Bool.and_eq_true, beq_iff_eq] at hnot12
              rcases hnot12 with ⟨⟨⟨hfu_b, hfv_b⟩, hfm3_b⟩, hm3_pol⟩
              have ⟨b1, b2⟩ := chainSeq_true h
              have hfu_in : toF7 u ∈ V_alt (toF7 fi) := by
                have := (inValtB_raw_iff fi (u % 7)).mp hfu_b; rwa [toF7_mod] at this
              have hfv_in : toF7 v ∈ V_alt (toF7 fi) := by
                have := (inValtB_raw_iff fi (v % 7)).mp hfv_b; rwa [toF7_mod] at this
              have hfm3 := hasFire_sound hK hfm3_b
              rw [toF7_mod, toF7_mod] at hfm3
              have hm3_eq : toF7 (chainOppB fi tag) = chainOppositeMissed (toF7 fi) (toF3 tag) := by
                rw [← chainOppB_mod]; exact chainOppB_eq (toF7 fi) (toF3 tag)
              rw [hm3_eq] at hfm3
              have hpol_m3 : intrinsicPol S w (chainOppositeMissed (toF7 fi) (toF3 tag)) = !s := by
                rw [← hm3_eq, ← hPol (toF7 (chainOppB fi tag)), polBit_raw]; exact hm3_pol
              obtain ⟨tag2, hne_t2, hf2⟩ := master_law_II hP hccw hA hH hfire hfm3
                (pair_subset_of_mem hfu_in hfv_in) hpol_m3
              rcases fin3_ne_succ_or_add2' tag2 (toF3 tag) hne_t2 with rfl | rfl
              · have ht1 : toF3 ((tag + 1) % 3) = toF3 ((toF3 tag).val + 1) := by
                  rw [toF3_mod]; exact Fin.ext (by simp [toF3])
                exact ih (.fire false fi ((tag + 1) % 3) s) _ _ hKnown2 (by dsimp [ModeHyp]; rwa [ht1]) b1
              · have ht2 : toF3 ((tag + 2) % 3) = toF3 ((toF3 tag).val + 2) := by
                  rw [toF3_mod]; exact Fin.ext (by simp [toF3])
                exact ih (.fire false fi ((tag + 2) % 3) s) _ _ hKnown2 (by dsimp [ModeHyp]; rwa [ht2]) b2
          · rw [Bool.eq_false_iff.mpr hop12] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
            cases hop13 : (op == 13)
            · rw [hop13] at h; exact Bool.noConfusion h
            · rw [hop13] at h; simp only [↓reduceIte] at h
              exact ih .root _ w1 hKnown2 trivial h
    | esc fi tag s =>
      have hesc : IotaEscapes P S w (toF7 fi) (toF3 tag) s := hM
      have hce_eq : chainEndB fi tag =
          ((chainEndpoints (toF7 fi) (toF3 tag)).1.val, (chainEndpoints (toF7 fi) (toF3 tag)).2.val) :=
        (chainEndB_mod fi tag).symm.trans (chainEndB_eq (toF7 fi) (toF3 tag))
      unfold verifyFuel at h
      rcases hpop0 : popTok wStream with ⟨op, w1⟩
      rw [hpop0] at h; dsimp only at h
      by_cases hop20 : op == 20
      · rw [hop20] at h; simp only [↓reduceIte, beq_iff_eq] at h
        subst h
        dsimp [ValidSec3Regime] at hReg
        exact hReg (toF7 fi) (toF3 tag) s hesc
      · rw [Bool.eq_false_iff.mpr hop20] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
        by_cases hop21 : op == 21
        · rw [hop21, hce_eq] at h
          simp only [↓reduceIte, Bool.and_eq_true, Bool.not_eq_true', Nat.ble_eq, dist7_eq_sub_val] at h
          have hext : IsExteriorStar S w k := by
            dsimp [ValidSec3Regime] at hReg; rwa [if_neg (by have := h.1.1; omega)] at hReg
          have htang := extStar_tangent_only_escape hP hccw hext hesc
          have hnt := h.2
          rcases htang with ⟨rfl, hae0, hdek⟩ | ⟨rfl, hbek, hsumk⟩
          · have hv0 : (chainEndpoints (toF7 fi) (toF3 tag)).1.val = 0 := congrArg Fin.val hae0
            simp [hv0, Nat.ble_eq.mpr hdek] at hnt
          · simp [hbek, hsumk] at hnt
        · rw [Bool.eq_false_iff.mpr hop21] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
          by_cases hop22 : op == 22
          · rw [hop22] at h
            rcases hpop1 : popTok w1 with ⟨xm, w2⟩
            rcases hpop2 : popTok w2 with ⟨u, w3⟩
            rcases hpop3 : popTok w3 with ⟨v, w4⟩
            rw [hpop1, hpop2, hpop3, hce_eq] at h
            simp only [↓reduceIte, Bool.and_eq_true, Bool.not_eq_true', bne_iff_ne] at h
            rcases h with ⟨⟨⟨⟨hxm_b, hfu_b⟩, hfv_b⟩, hf_b⟩, hne⟩
            have hxm_out : toF7 xm ∉ V_alt (toF7 fi) := by
              have := (inValtB_raw_false_iff fi (xm % 7)).mp hxm_b; rwa [toF7_mod] at this
            have hfu_in : toF7 u ∈ V_alt (toF7 fi) := by
              have := (inValtB_raw_iff fi (u % 7)).mp hfu_b; rwa [toF7_mod] at this
            have hfv_in : toF7 v ∈ V_alt (toF7 fi) := by
              have := (inValtB_raw_iff fi (v % 7)).mp hfv_b; rwa [toF7_mod] at this
            have hfx := hasFire_sound hK hf_b
            rw [toF7_mod, toF7_mod, toF7_mod] at hfx
            have hsign := law_05_star_sign hP hfx (pair_subset_of_mem hfu_in hfv_in) hxm_out
            let fm := if s then (chainEndpoints (toF7 fi) (toF3 tag)).1
                      else (chainEndpoints (toF7 fi) (toF3 tag)).2
            have hesc_s : orientSign (w (V_alt (toF7 fi))) (w Finset.univ) (S (toF7 xm)) =
                (if toF7 xm = fm then !s else s) := by
              by_cases heqm : toF7 xm = fm
              · rw [if_pos heqm, heqm]; exact hesc.1
              · rw [if_neg heqm]; exact hesc.2.1 (toF7 xm) heqm
            rw [hesc_s] at hsign
            have hm_val : (if s then (chainEndpoints (toF7 fi) (toF3 tag)).1.val
                          else (chainEndpoints (toF7 fi) (toF3 tag)).2.val) = fm.val := by
              dsimp [fm]; cases s <;> rfl
            rw [hm_val, polBit_mod, hPol (toF7 xm), ← hsign] at hne
            by_cases heqm : toF7 xm = fm
            · have hv_eq : xm % 7 = fm.val := congrArg Fin.val heqm
              simp [heqm, hv_eq] at hne
            · have hv_ne : (xm % 7 == fm.val) = false :=
                beq_eq_false_iff_ne.mpr (fun hv => heqm (Fin.ext hv))
              simp [heqm, hv_ne] at hne
          · rw [Bool.eq_false_iff.mpr hop22] at h; simp only [Bool.false_eq_true, ↓reduceIte] at h
            by_cases hop23 : op == 23
            · rw [hop23] at h
              rcases hpop1 : popTok w1 with ⟨xm, w2⟩
              rcases hpop2 : popTok w2 with ⟨ac, w3⟩
              rcases hpop3 : popTok w3 with ⟨bc, w4⟩
              rw [hpop1, hpop2, hpop3, hce_eq] at h
              simp only [↓reduceIte, Bool.and_eq_true, Bool.not_eq_true', Nat.ble_eq, dist7_mod_eq] at h
              rcases h with ⟨⟨⟨⟨⟨⟨hxm_b, hac_b⟩, hbc_b⟩, hd1⟩, hd2⟩, hf_b⟩, hsub_b⟩
              have hxm_out : toF7 xm ∉ V_alt (toF7 fi) := by
                have := (inValtB_raw_false_iff fi (xm % 7)).mp hxm_b; rwa [toF7_mod] at this
